---
interface Props {
  mascotImage?: string;
}

const {
  mascotImage = '/images/Characters/Tess-chan.webp'
} = Astro.props;
---

<section class="hero" data-hero id="top">
  <div class="hero__bg"></div>

  <div class="hero__content">
    <slot />
  </div>

  <div class="hero__mascot">
    <img src={mascotImage} alt="Tess-chan mascot" class="hero__mascot-image" loading="eager" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 92vh;
    background-color: #0a0a0a;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/Backgrounds/background.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: var(--page-padding);
    padding-top: 9rem;
    padding-bottom: 4rem;
  }

  .hero__mascot {
    position: absolute;
    right: 0;
    bottom: 0;
    height: 85%;
    max-width: 32vw;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    pointer-events: none;
    z-index: 1;
  }

  .hero__mascot-image {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom right;
    opacity: 0.9;
  }

  @media (max-width: 992px) {
    .hero {
      min-height: auto;
      padding-bottom: 2rem;
    }

    .hero__mascot {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero__content {
      padding-top: 6.5rem;
      padding-bottom: 2rem;
    }
  }
</style>

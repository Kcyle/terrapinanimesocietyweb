---
import BaseLayout from '../../layouts/BaseLayout.astro';
import schedule from '../../data/kamecon-schedule.json';

// =====================================================================
//  EDIT HERE: links and images. Schedule content lives in
//  src/data/kamecon-schedule.json
// =====================================================================
const BG_IMAGE = '/images/Kamecon/kameback.jpeg';
const BACK_URL = '/kamecon';

const SOCIALS = {
  discord: 'https://discord.gg/qqsyXrk7fP',
  instagram: 'https://www.instagram.com/terrapinanimesociety/?utm_source=ig_web_button_share_sheet',
  youtube: 'https://www.youtube.com/@terrapinanimesociety8278',
};

const TABS = [
  { id: 'stage', label: 'Main stage' },
  { id: 'cosplay', label: 'Cosplay' },
  { id: 'arcade', label: 'Arcade' },
];

// Text label for each category, so meaning never depends on color alone
const TYPE_LABEL: Record<string, string> = {
  info: 'Info',
  panel: 'Panel',
  show: 'Stage show',
  band: 'Band or DJ',
};

const { stage, cosplay, arcade } = schedule;
---

<BaseLayout title="Event Schedule | KAMECON 2026" description="The KAMECON 2026 event schedule: main stage, cosplay competition, and arcade.">
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@800&family=Oxanium:wght@500;800&family=Chakra+Petch:wght@400;500;600&family=Share+Tech+Mono&display=swap" />
  <script slot="head" is:inline>document.documentElement.classList.add('kc-js');</script>

  <a class="kc__skip" href="#kc-schedule">Skip to schedule</a>

  <main class="kc">
    <div class="kc__bg" style={`background-image: url('${BG_IMAGE}')`} aria-hidden="true"></div>

    <div class="kc__top">
      <a class="kc__btn kc__back" href={BACK_URL}><span aria-hidden="true">&larr;</span> Back to KAMECON</a>
    </div>

    <header class="kc__head" data-kc-in>
      <h1 class="kc__glitch kc__h1">
        <span class="kc__gl-main">Event schedule</span>
        <span class="kc__gl-a" aria-hidden="true">Event schedule</span>
        <span class="kc__gl-b" aria-hidden="true">Event schedule</span>
      </h1>
    </header>

    <div class="kc__wrap" id="kc-schedule" data-kc-in>
      <div class="kc__tabs" role="tablist" aria-label="Schedule sections" data-tabs>
        {TABS.map((t, i) => (
          <button
            type="button"
            class="kc__tab"
            role="tab"
            id={`tab-${t.id}`}
            data-tab={t.id}
            aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >{t.label}</button>
        ))}
      </div>

      <!-- MAIN STAGE -->
      <section class="kc__panel is-active" role="tabpanel" id="panel-stage" aria-labelledby="tab-stage" tabindex="0">
        <h2 class="kc__h2">Main stage</h2>
        <ul class="kc__meta" aria-label="Main stage details">
          <li><span class="kc__meta-k">Location</span> {stage.location}</li>
          <li><span class="kc__meta-k">Open</span> {stage.hours}</li>
        </ul>

        <div class="kc__tl">
        {stage.groups.map((g, gi) => (
          <section class="kc__group" aria-labelledby={`grp-${gi}`}>
            <h3 class="kc__grp" id={`grp-${gi}`}>{g.name}{g.note && <span class="kc__grp-note">{g.note}</span>}</h3>
            <ol class="kc__list">
              {g.items.map((it) => (
                <li class={`kc__item kc__item--${it.type}`}>
                  <p class="kc__time">
                    <time>{it.start}</time>
                    {'end' in it && it.end && (<><span aria-hidden="true"> &ndash; </span><span class="kc__sr"> to </span><time>{it.end}</time></>)}
                  </p>
                  <div class="kc__what">
                    <p class="kc__name">{it.title}</p>
                    {'note' in it && it.note && <p class="kc__note">{it.note}</p>}
                  </div>
                  <div class="kc__end">
                    {'link' in it && it.link && (
                      <a class={`kc__ig${'linkLabel' in it && it.linkLabel === 'Facebook' ? ' kc__ig--fb' : ''}`} href={it.link} target="_blank" rel="noopener noreferrer">{'linkLabel' in it && it.linkLabel ? it.linkLabel : 'Instagram'}<span class="kc__sr"> for {it.title} (opens in a new tab)</span><span aria-hidden="true">&nearr;</span></a>
                    )}
                    <span class="kc__tag">{TYPE_LABEL[it.type]}</span>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
        </div>
      </section>

      <!-- COSPLAY -->
      <section class="kc__panel" role="tabpanel" id="panel-cosplay" aria-labelledby="tab-cosplay" tabindex="0">
        <h2 class="kc__h2">Cosplay</h2>
        <ul class="kc__meta" aria-label="Cosplay details">
          <li><span class="kc__meta-k">Location</span> {cosplay.location}</li>
          <li><span class="kc__meta-k">Open</span> {cosplay.hours}</li>
        </ul>
        <div class="kc__cards">
          <article class="kc__card">
            <h3 class="kc__h3">How to sign up</h3>
            <ol class="kc__steps">
              {cosplay.steps.map((s) => <li>{s}</li>)}
            </ol>
          </article>
          <article class="kc__card">
            <h3 class="kc__h3">Ground rules</h3>
            <ul class="kc__bullets">
              {cosplay.rules.map((r) => <li>{r}</li>)}
            </ul>
          </article>
        </div>

        <section class="kc__meetups" aria-labelledby="meetups-h">
          <h3 class="kc__h2 kc__meetups-h" id="meetups-h">Cosplay meetups</h3>
          <ol class="kc__tl kc__tl--meet">
            {cosplay.meetups.map((m) => (
              <li class={`kc__item kc__item--panel${'contest' in m && m.contest ? ' kc__item--contest' : ''}`}>
                <p class="kc__time"><time>{m.start}</time><span aria-hidden="true"> &ndash; </span><span class="kc__sr"> to </span><time>{m.end}</time></p>
                <div class="kc__what">
                  <p class="kc__name">{m.title}</p>
                  <p class="kc__note"><span class="kc__meet-k">{m.leaders.length > 1 ? 'Leaders' : 'Leader'}</span> {m.leaders.join(' & ')}</p>
                </div>
                {'contest' in m && m.contest && <div class="kc__end"><span class="kc__tag">Contest</span></div>}
              </li>
            ))}
          </ol>
        </section>
      </section>

      <!-- ARCADE -->
      <section class="kc__panel" role="tabpanel" id="panel-arcade" aria-labelledby="tab-arcade" tabindex="0">
        <h2 class="kc__h2">Arcade</h2>
        <p class="kc__notice"><span class="kc__notice-k">Required</span> {arcade.controllerNote}</p>

        <h3 class="kc__h3 kc__h3--lg">Tournaments</h3>
        <a class="kc__register" href={arcade.registerUrl} target="_blank" rel="noopener noreferrer">
          {arcade.registerLabel}<span class="kc__sr"> (opens in a new tab)</span><span aria-hidden="true">&nearr;</span>
        </a>
        <p class="kc__prize"><span class="kc__prize-k">Reward</span> {arcade.prizeNote}</p>
        <ol class="kc__tours">
          {arcade.tournaments.map((t) => (
            <li class="kc__tour">
              <p class="kc__time"><time>{t.time}</time></p>
              <div class="kc__what">
                <p class="kc__name">{t.name}</p>
                <p class="kc__note">{t.host}</p>
              </div>
              <div class="kc__acts">
                {'signup' in t && t.signup && (
                  <a class="kc__link" href={t.signup} target="_blank" rel="noopener noreferrer">Sign up<span class="kc__sr"> for {t.name} (opens in a new tab)</span></a>
                )}
                <span class={`kc__tag${t.prize ? ' kc__tag--prize' : ''}`}>{t.prize ? 'Gift card' : 'No prize'}</span>
              </div>
            </li>
          ))}
        </ol>

        <h3 class="kc__h3 kc__h3--lg">Freeplay and stations</h3>
        {arcade.stations.map((s, i) => (
          <details class="kc__acc" open={i === 0}>
            <summary>
              <span class="kc__acc-name">{s.name}</span>
              <span class="kc__acc-info">{'host' in s && s.host ? `${s.host} \u00b7 ` : ''}{s.games.length} games</span>
            </summary>
            <div class="kc__acc-body">
              <ul class="kc__chips">
                {s.games.map((g) => <li>{g}</li>)}
              </ul>
              {'link' in s && s.link && (
                <a class="kc__link" href={s.link.url} target="_blank" rel="noopener noreferrer">{s.link.label}<span class="kc__sr"> (opens in a new tab)</span></a>
              )}
            </div>
          </details>
        ))}
      </section>
    </div>

    <footer class="kc__social" aria-label="Social media">
      <a href={SOCIALS.discord} target="_blank" rel="noopener noreferrer" aria-label="Discord (opens in a new tab)"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path></svg><span>Discord</span></a>
      <a href={SOCIALS.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram (opens in a new tab)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
        <span>Instagram</span>
      </a>
      <a href={SOCIALS.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube (opens in a new tab)"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"></path></svg><span>YouTube</span></a>
    </footer>
  </main>
</BaseLayout>

<script>
  import gsap from 'gsap';

  function initTabs() {
    const list = document.querySelector<HTMLElement>('[data-tabs]');
    if (!list) return;
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);

    function select(i: number, opts: { focus?: boolean; hash?: boolean } = {}) {
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[k].classList.toggle('is-active', on);
      });
      if (opts.focus) tabs[i].focus();
      if (opts.hash) history.replaceState(null, '', `#${tabs[i].dataset.tab}`);
    }

    function fromHash() {
      const i = tabs.findIndex((t) => `#${t.dataset.tab}` === location.hash);
      return i >= 0 ? i : 0;
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i, { hash: true }));
      t.addEventListener('keydown', (e) => {
        let n = -1;
        if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = tabs.length - 1;
        if (n < 0) return;
        e.preventDefault();
        select(n, { focus: true, hash: true });
      });
    });

    window.addEventListener('hashchange', () => select(fromHash()));
    select(fromHash());
  }

  function init() {
    initTabs();
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.from('[data-kc-in]', { y: 40, opacity: 0, duration: 0.7, stagger: 0.15, ease: 'power3.out' });
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>

<style>
  .kc {
    --kc-bg: #0b0d12;
    --kc-surface: #131b29;
    --kc-panel: #101a2b;
    --kc-line: #1b4a7a;
    --kc-blue: #2f8fe0;
    --kc-neon: #1e9bff;
    --kc-cyan: #6fd3ff;
    --kc-border: #4a2433;
    --kc-hi: #ff8a9b;
    --kc-font-head: 'Oxanium', sans-serif;
    --kc-font-label: 'Share Tech Mono', monospace;
    --kc-text: #e6ecf3;
    --kc-sub: #9aa6b8;
    --kc-red: #e0314f;
    --kc-red-dark: #c4203c;
    --kc-rose: #b8527a;
    --kc-gray: #7c8799;
    --cut: 10px;
    position: relative;
    min-height: 100vh;
    background: var(--kc-bg);
    color: var(--kc-text);
    font-family: 'Chakra Petch', sans-serif;
    padding: 0 clamp(1rem, 4vw, 3rem) 2.5rem;
  }

  .kc__bg { position: fixed; inset: 0; z-index: 0; background-size: cover; background-position: center; pointer-events: none; }
  .kc__bg::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgba(30, 155, 255, 0.04) 0, rgba(30, 155, 255, 0.04) 1px, transparent 1px, transparent 4px), rgba(11, 13, 18, 0.88); }
  .kc > :not(.kc__bg) { position: relative; z-index: 1; }

  .kc__sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .kc__skip { position: absolute; left: 0.75rem; top: -4rem; z-index: 1000; background: var(--kc-red-dark); color: #fff; font-family: var(--kc-font-label); font-size: 0.65rem; text-transform: uppercase; padding: 0.7rem 1rem; }
  .kc__skip:focus { top: 0.75rem; outline: 2px solid var(--kc-hi); outline-offset: 2px; }

  .kc__top { padding-top: 1.5rem; max-width: 56rem; margin: 0 auto; }
  .kc__head { max-width: 56rem; margin: 0 auto; padding: 1.25rem 0; }
  .kc__h1 { font-size: clamp(1.2rem, 6vw, 2.2rem); margin: 0; }

  .kc__glitch { position: relative; display: block; width: fit-content; font-family: 'Orbitron', sans-serif; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; line-height: 1.15; color: var(--kc-neon); overflow-wrap: break-word; }
  .kc__gl-main { text-shadow: 0 0 14px rgba(30, 155, 255, 0.7); }
  .kc__gl-a, .kc__gl-b { position: absolute; top: 0; width: 100%; pointer-events: none; user-select: none; }
  .kc__gl-a { left: 2px; color: var(--kc-red); clip-path: inset(0 0 58% 0); opacity: 0.85; }
  .kc__gl-b { left: -2px; color: var(--kc-cyan); clip-path: inset(60% 0 0 0); opacity: 0.7; }


  /* Chamfered controls: border is an inset ring because clip-path would cut a real one */
  .kc__btn, .kc__tab {
    font-family: var(--kc-font-label); text-transform: uppercase; letter-spacing: 0.08em;
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
    min-height: 2.4rem; padding: 0.7rem 1.1rem; font-size: 0.65rem; font-weight: 600; color: var(--kc-text);
    background: var(--kc-panel); border: 0; box-shadow: inset 0 0 0 1px var(--kc-neon);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));
    transition: background 0.2s; cursor: pointer;
  }
  .kc__btn:hover, .kc__tab:hover { background: #16304f; }
  .kc__back { padding: 0.5rem 0.9rem; }

  .kc__wrap { max-width: 56rem; margin: 0 auto; }

  /* Tabs: hidden until JS is running; without JS every section just stacks */
  .kc__tabs { display: none; gap: 0.6rem; margin-bottom: 1.5rem; }
  :global(html.kc-js) .kc__tabs { display: flex; }
  .kc__tab { flex: 1 1 0; min-height: 2.6rem; padding: 0.7rem 0.75rem; }
  .kc__tab[aria-selected='true'] { background: rgba(30, 155, 255, 0.18); color: var(--kc-cyan); box-shadow: inset 0 0 0 1px var(--kc-cyan), inset 0 -3px 0 var(--kc-red); }

  .kc__panel { display: block; margin-bottom: 2.5rem; }
  :global(html.kc-js) .kc__panel:not(.is-active) { display: none; }

  .kc__h2 { font-family: var(--kc-font-head); font-size: 1.4rem; font-weight: 800; text-transform: uppercase; color: var(--kc-hi); margin-bottom: 0.75rem; letter-spacing: 0.02em; }
  .kc__h3 { font-family: var(--kc-font-head); font-size: 0.9rem; font-weight: 800; text-transform: uppercase; color: var(--kc-cyan); margin-bottom: 0.6rem; }
  .kc__h3--lg { font-size: 1.05rem; margin: 1.75rem 0 0.6rem; }

  .kc__meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; }
  .kc__meta li { font-family: var(--kc-font-label); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--kc-text); background: var(--kc-panel); box-shadow: inset 0 0 0 1px var(--kc-border); padding: 0.4rem 0.75rem; }
  .kc__meta-k { color: var(--kc-cyan); margin-right: 0.4rem; }

  /* Timeline */
  .kc__tl { position: relative; margin-left: 0.4rem; padding-left: 1.4rem; border-left: 2px solid var(--kc-line); }
  .kc__grp { font-family: var(--kc-font-label); font-size: 0.6rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: var(--kc-cyan); margin: 1.3rem 0 0.25rem; display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; }
  .kc__grp::before { content: '>'; content: '>' / ''; color: var(--kc-red); margin-right: -0.25rem; }
  .kc__grp-note { color: var(--kc-sub); letter-spacing: 0.03em; text-transform: none; font-family: 'Chakra Petch', sans-serif; font-size: 0.65rem; }

  .kc__item {
    --k: var(--kc-gray); --c: var(--kc-sub);
    position: relative; display: grid; grid-template-columns: 9.5rem minmax(0, 1fr) auto; gap: 0.25rem 0.9rem; align-items: center;
    padding: 0.55rem 0.6rem; border-bottom: 1px dashed #1d2638; transition: background 0.2s;
  }
  .kc__item::before { content: ''; position: absolute; left: -1.95rem; top: 50%; width: 0.6rem; height: 0.6rem; margin-top: -0.3rem; transform: rotate(45deg); background: var(--k); box-shadow: 0 0 10px var(--k); }
  .kc__item--panel { --k: var(--kc-neon); --c: var(--kc-cyan); }
  .kc__item--show { --k: var(--kc-rose); --c: var(--kc-hi); }
  .kc__item--band { --k: var(--kc-red); --c: #ff6b84; }
  .kc__meetups { margin-top: 1.9rem; padding-top: 1.4rem; border-top: 1px dashed var(--kc-line); }
  .kc__meetups-h { margin-bottom: 0.4rem; }
  .kc__intro { font-size: 0.68rem; color: var(--kc-sub); margin: 0 0 0.6rem; }
  .kc__tl--meet { margin-left: 0.4rem; }
  .kc__meet-k { font-family: var(--kc-font-label); font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--kc-cyan); margin-right: 0.35rem; }
  .kc__item--contest { --k: var(--kc-red); --c: #ff6b84; background: rgba(224, 49, 79, 0.1); box-shadow: inset 3px 0 0 var(--kc-red); }
  .kc__item--contest .kc__name { color: var(--kc-hi); }
  .kc__item--contest:hover { background: rgba(224, 49, 79, 0.14); }
  .kc__end { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 0.5rem; }
  .kc__ig {
    font-family: var(--kc-font-label); font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;
    display: inline-flex; align-items: center; gap: 0.3rem; min-height: 1.9rem; padding: 0.4rem 0.75rem; color: #fff; white-space: nowrap;
    background: linear-gradient(90deg, #a8456b, #c4203c);
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
  }
  .kc__ig--fb { background: linear-gradient(90deg, #1a5fb0, #1a6fc4); }
  .kc__ig:hover { filter: brightness(1.18); }
  .kc__item:hover, .kc__tour:hover { background: rgba(30, 155, 255, 0.07); }
  .kc__time { font-family: var(--kc-font-label); font-size: 0.62rem; color: var(--kc-cyan); }
  .kc__name { font-family: var(--kc-font-head); font-size: clamp(0.95rem, 2.6vw, 1.15rem); font-weight: 800; color: var(--kc-text); letter-spacing: -0.01em; line-height: 1.2; }
  .kc__note { font-size: 0.65rem; color: var(--kc-sub); line-height: 1.5; margin-top: 0.1rem; }
  .kc__tag { font-family: var(--kc-font-label); font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c, var(--kc-sub)); box-shadow: inset 0 0 0 1px var(--k, var(--kc-border)); padding: 0.2rem 0.5rem; white-space: nowrap; }

import BaseLayout from '../layouts/BaseLayout.astro';
//import kameconData from '../../data/kamecon.json';
import kameconData from "../data/kamecon.json";

// =====================================================================
//  EDIT HERE: image filepaths, links, and popup text
//  Leave a path as '' to show a labeled placeholder box instead.
//  Files in /public are referenced from the root, e.g. '/images/Logos/kamecon2026.webp'
// =====================================================================

// TODO: INSERT TAS LOGO FILEPATH MANUALLY (shown top-left; clicking it returns to the home page)
const TAS_LOGO = '/images/Icons/Cyber_Tess.png';
const TAS_HOME_URL = '/'; // clicking the TAS logo goes here (home page)

// TODO: INSERT BACKGROUND IMAGE FILEPATH MANUALLY (sits behind the whole page, e.g. '/images/Backgrounds/kamecon2026.webp')
const BG_IMAGE = '/images/Kamecon/kameback.jpeg';

// TODO: INSERT KAMECON 2026 LOGO FILEPATH MANUALLY (shown in the page header)
const KAMECON_LOGO = '/images/Kamecon/kamecon_logo.webp';

// TODO: INSERT PHOTO FILEPATHS MANUALLY (max 3 per carousel, they rotate automatically)
const PHOTOS_1 = [
  '/images/Kamecon/kamegen1.jpg', // TODO: INSERT PHOTO 1, slide 1 FILEPATH
  '/images/Kamecon/kamegen2.jpg', // TODO: INSERT PHOTO 1, slide 2 FILEPATH
  '/images/Kamecon/kamegen3.jpg', // TODO: INSERT PHOTO 1, slide 3 FILEPATH
];
const PHOTOS_2 = [
  '/images/Kamecon/concert1.jpeg', // TODO: INSERT PHOTO 2, slide 1 FILEPATH
  '/images/Kamecon/concert2.jpeg', // TODO: INSERT PHOTO 2, slide 2 FILEPATH
  '/images/Kamecon/concert3.jpeg', // TODO: INSERT PHOTO 2, slide 3 FILEPATH
];

// TODO: INSERT VENDOR LOGO FILEPATHS MANUALLY (max 3 logos per vendor, they rotate)
// Add or remove vendor objects as needed. The list scrolls.
const VENDORS = kameconData.vendors;

// Tickets now opens a "coming soon" popup (see POPUPS below).
// When tickets go on sale, swap the Tickets button in the nav for a link to:
// https://umdtickets.universitytickets.com/w/event.aspx?id=1669
const CONTACT_URL = '/contact';

const SOCIALS = {
  discord: 'https://discord.gg/qqsyXrk7fP',
  instagram: 'https://www.instagram.com/terrapinanimesociety/?utm_source=ig_web_button_share_sheet',
  youtube: 'https://www.youtube.com/@terrapinanimesociety8278',
};

// Event Schedule now lives on its own page
const SCHEDULE_URL = '/kamecon/schedule';

// Countdown target: doors open Nov 15, 2026, 11:00 AM Eastern (EST, UTC-5, after the Nov 1 clock change).
// The countdown switches to "happening now" at start and to a thank-you after EVENT_END (10:00 PM EST).
const EVENT_START = '2026-11-15T11:00:00-05:00';
const EVENT_END = '2026-11-15T22:00:00-05:00';

// Popup content for Tickets, Parking and Harassment Policy.
// Buttons are wired by id in the nav (data-modal-open). `body` = plain paragraphs. `sections` = headed blocks made of p / ul / callout / links.
const POPUPS = [
  { id: 'tickets', label: 'Tickets', title: 'Tickets', body: ['Tickets coming soon.'] },
  {
    id: 'parking', label: 'Parking', title: 'Parking',
    // Text below is word-for-word from the parking doc. `html` blocks are trusted, hand-written strings (used only for bold words).
    sections: [
      {
        heading: 'Free parking options', badge: { text: 'Free', tone: 'free' },
        blocks: [
          { html: 'Nearest <strong>free</strong> parking to STAMP:' },
          { card: { title: 'Regent\u2019s Drive Garage', rows: [['Address:', 'Lot B, College Park, MD 20742'], ['', '7 minute walk from STAMP']] } },
          { p: 'If space in the garage runs out, there are other free available parking lots on campus but they are about a 10 minute walk from the venue.' },
          { lead: 'There are two ways to identify parking lots available for free parking on Sunday.' },
          { ul: [
            { text: 'Please reference the official UMD parking map. Locations marked in green are free on Sunday', link: { label: 'https://transportation.umd.edu/parking/maps/umd-campus-parking-map', href: 'https://transportation.umd.edu/parking/maps/umd-campus-parking-map' } },
            'Black numbered signs also indicate if a parking lot is free on Sundays',
          ], info: true },
          { callout: 'Lots 1B, 1D, 1F are about 10 minute walk from the venue and are free on Sunday.' },
        ],
      },
      {
        heading: 'Paid parking options', badge: { text: 'Paid', tone: 'paid' },
        blocks: [
          { html: 'Nearest parking garage to STAMP (<strong>PAID</strong> parking right next to the building)' },
          { card: { title: 'Union Lane Garage', rows: [['Address:', 'Union Lane Garage, College Park, MD 20740'], ['', 'Paid parking through credit card, cash, or Parkmobile App, $4/hour, ($20 max)']] } },
        ],
      },
    ],
  },
  {
    id: 'policy', label: 'Harassment Policy', title: 'Harassment Policy',
    sections: [
      {
        blocks: [
          { p: 'Harassment includes, but is not limited to:' },
          { ul: ['Threats of violence.', 'Unlawful acts of violence.', 'Nonconsensual sexual advances.', 'A pattern of conduct towards others that reasonably causes emotional distress or alarm.'] },
          { callout: 'In summary: don\u2019t ruin KAMECON for others.' },
        ],
      },
      {
        heading: 'Consequences for violations',
        blocks: [{ p: 'If someone is found to be in violation of the KAMECON Harassment Policy, they will be removed from the event and potentially banned from attending in the future. When appropriate, legal action may be taken.' }],
      },
      {
        heading: 'How to report harassment',
        blocks: [
          { p: 'If you are being harassed by a KAMECON attendee, please reach out to the nearest staff member to report your experience. You can also fill out the reporting form or email us at terrapinanimesociety@gmail.com with the phrase \u201cHARASSMENT INCIDENT\u201d in the subject line.' },
          { links: [
            { label: 'Reporting form', href: 'https://forms.gle/CU2TfURH6yTSveGi9', external: true, primary: true },
            { label: 'Email us', href: 'mailto:terrapinanimesociety@gmail.com?subject=HARASSMENT%20INCIDENT', primary: false },
          ] },
        ],
      },
      {
        heading: 'If the harassment is by event staff',
        blocks: [
          { p: 'The options above are still available to you. We would also recommend reaching out to Stamp and/or UMD staff or security. When emailing us about these incidents, please write \u201cSTAFF HARASSMENT INCIDENT\u201d in the subject line. Stamp staff can be found throughout the Stamp building, or you can email stampinfo@umd.edu.' },
          { links: [{ label: 'Email Stamp', href: 'mailto:stampinfo@umd.edu', primary: false }] },
        ],
      },
    ],
  },
];
const popup = (id: string) => POPUPS.find((p) => p.id === id)!;
---

<BaseLayout title="KAMECON 2026 | Terrapin Anime Society">
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@800&family=Oxanium:wght@500;800&family=Chakra+Petch:wght@400;500;600&family=Share+Tech+Mono&display=swap" />

  <main class="kc">
    <div class="kc__bg" style={BG_IMAGE ? `background-image: url('${BG_IMAGE}')` : undefined} aria-hidden="true"></div>
    <div class="kc__top">
      <a class="kc__tas" href={TAS_HOME_URL} aria-label="Terrapin Anime Society home">
        {TAS_LOGO ? <img src={TAS_LOGO} alt="Terrapin Anime Society logo" /> : <span class="kc__ph">TAS logo</span>}
      </a>
    </div>

    <section class="kc__hero" data-kc-in>
      <div class="kc__logo">
        {/* TODO: set KAMECON_LOGO above to show your logo image. Until then, the blue text title below is shown. */}
        {KAMECON_LOGO ? <img src={KAMECON_LOGO} alt="KAMECON 2026 logo" /> : <h1 class="kc__title"><span class="kc__title-main">KAMECON</span><span class="kc__title-year">2026</span></h1>}
      </div>
      <p class="kc__welcome">Welcome to KAMECON 2026, a yearly anime convention at the University of Maryland.</p>
      <p class="kc__date">November 15th, 2026</p>
      <div class="kc__countdown" data-countdown data-start={EVENT_START} data-end={EVENT_END} role="timer" aria-labelledby="kc-cd-label" hidden>
        <p class="kc__cd-label" id="kc-cd-label" data-cd-label>Doors open in</p>
        <div class="kc__cd-panel" data-cd-grid>
          <div class="kc__cd-seg">
            <div class="kc__cd-unit"><span class="kc__cd-num" data-cd="days">00</span><span class="kc__cd-lbl">Days</span></div>
            <span class="kc__cd-colon" aria-hidden="true">:</span>
            <div class="kc__cd-unit"><span class="kc__cd-num" data-cd="hours">00</span><span class="kc__cd-lbl">Hours</span></div>
            <span class="kc__cd-colon" aria-hidden="true">:</span>
            <div class="kc__cd-unit"><span class="kc__cd-num" data-cd="minutes">00</span><span class="kc__cd-lbl">Minutes</span></div>
            <span class="kc__cd-colon" aria-hidden="true">:</span>
            <div class="kc__cd-unit"><span class="kc__cd-num" data-cd="seconds">00</span><span class="kc__cd-lbl">Seconds</span></div>
          </div>
        </div>
        <p class="kc__cd-note" data-cd-note>Doors open 11:00 AM EST</p>
      </div>
      <p class="kc__cta-text">Tickets coming soon</p>
      <nav class="kc__nav" aria-label="KAMECON links">
        <button type="button" class="kc__btn kc__btn--tickets" data-modal-open="tickets">{popup('tickets').label}</button>
        <a class="kc__feature" href={SCHEDULE_URL}>
          <span class="kc__feature-tag">See the lineup</span>
          <span class="kc__feature-txt">
            <span class="kc__feature-ttl">Event Schedule</span>
            <span class="kc__feature-sub">Stage &middot; Cosplay &middot; Arcade</span>
          </span>
          <span class="kc__feature-arr" aria-hidden="true">&gt;&gt;</span>
        </a>
        <div class="kc__nav-row">
          <button type="button" class="kc__btn" data-modal-open="parking">{popup('parking').label}</button>
          <button type="button" class="kc__btn" data-modal-open="policy">{popup('policy').label}</button>
          <a class="kc__btn" href={CONTACT_URL || undefined}>Contact</a>
        </div>
      </nav>
      <div class="kc__notice" role="note">
        <span class="kc__notice-dot" aria-hidden="true"></span>
        <p><span class="kc__notice-k">Stay tuned</span>This site will be updated as more info about KAMECON is released.</p>
      </div>
    </section>

    <section class="kc__grid" data-kc-in>
      <div class="kc__photos">
        {[PHOTOS_1, PHOTOS_2].map((photos, n) => (
          <div class="kc__carousel" data-carousel data-interval="4500" data-delay={n * 1200}>
            <div class="kc__track" data-track>
              {photos.map((src, i) => (
                <div class="kc__slide">
                  {src ? <img src={src} alt={`KAMECON photo ${n + 1}, slide ${i + 1}`} /> : <span class="kc__ph">{`Photo ${n + 1}, slide ${i + 1}`}</span>}
                </div>
              ))}
            </div>
            <div class="kc__dots" data-dots></div>
          </div>
        ))}
      </div>

      <div class="kc__vendors">
        <h2 class="kc__vendors-title">Vendors</h2>
        <div class="kc__vendors-scroll" tabindex="0" aria-label="Vendor list, scrollable">
          {VENDORS.map((v, n) => (
            <article class="kc__vendor">
              <div class="kc__vendor-logo kc__carousel kc__carousel--mini" data-carousel data-interval="3500" data-delay={n * 500}>
                <div class="kc__track" data-track>
                  {(v.logos ?? []).map((src, i) => (
                    <div class="kc__slide">
                      {src ? <img src={src} alt={`${v.name} logo ${i + 1}`} /> : <span class="kc__ph">Vendor logo</span>}
                    </div>
                  ))}
                </div>
                <div class="kc__dots" data-dots></div>
              </div>
              <div class="kc__vendor-info">
                <h3>{v.name}</h3>
                <p>{v.description}</p>
                {v.social && <a class="kc__vendor-link" href={v.social} target="_blank" rel="noopener noreferrer">{v.socialDisplay}<span class="kc__sr"> (opens in a new tab)</span></a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <footer class="kc__social" aria-label="Social media">
      <a href={SOCIALS.discord} target="_blank" rel="noopener noreferrer" aria-label="Discord"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path></svg><span>Discord</span></a>
      <a href={SOCIALS.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
        <span>Instagram</span>
      </a>
      <a href={SOCIALS.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"></path></svg>
        <span>YouTube</span>
      </a>
    </footer>
  </main>

  {POPUPS.map((p) => (
    <dialog class="kc__dialog" id={`modal-${p.id}`} aria-labelledby={`modal-${p.id}-t`}>
      <div class="kc__frame">
        <div class="kc__dlg">
          <div class="kc__dhead">
            <h2 id={`modal-${p.id}-t`} class="kc__glitch kc__dtitle">
              <span class="kc__gl-main">{p.title}</span>
              <span class="kc__gl-a" aria-hidden="true">{p.title}</span>
              <span class="kc__gl-b" aria-hidden="true">{p.title}</span>
            </h2>
            <button type="button" class="kc__close" data-modal-close aria-label={`Close ${p.title}`}>&times;</button>
          </div>
          <div class="kc__dialog-body">
            {p.body?.map((t) => <p>{t}</p>)}
            {p.sections?.map((sec) => (
              <section class="kc__dsec">
                {sec.heading && <h3>{sec.heading}{'badge' in sec && sec.badge && <span class={`kc__badge kc__badge--${sec.badge.tone}`} aria-hidden="true">{sec.badge.text}</span>}</h3>}
                {sec.blocks.map((b) => (
                  <>
                    {'p' in b && <p>{b.p}</p>}
                    {'card' in b && (
                      <div class="kc__dcard">
                        <h4>{b.card.title}</h4>
                        <dl class="kc__dkv">
                          {b.card.rows.map((r) => (r[0] ? (<><dt>{r[0]}</dt><dd>{r[1]}</dd></>) : <dd class="kc__dkv-full">{r[1]}</dd>))}
                        </dl>
                      </div>
                    )}
                    {'lead' in b && <p class="kc__dlead">{b.lead}</p>}
                    {'html' in b && <p class="kc__dlead" set:html={b.html} />}
                    {'ul' in b && <ul class={`kc__dlist${'info' in b && b.info ? ' kc__dlist--info' : ''}`}>{b.ul.map((li) => (typeof li === 'string' ? <li>{li}</li> : (
                      <li>{li.text}{li.link && (
                        <span class="kc__dsub">Link: <a href={li.link.href} target="_blank" rel="noopener noreferrer">{li.link.label}<span class="kc__sr"> (opens in a new tab)</span></a></span>
                      )}</li>
                    )))}</ul>}
                    {'callout' in b && <p class="kc__callout">{b.callout}</p>}
                    {'links' in b && (
                      <div class="kc__dlinks">
                        {b.links.map((l) => (
                          <a class={`kc__dlink${l.primary ? ' kc__dlink--primary' : ''}`} href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>
                            {l.label}{l.external && <span class="kc__sr"> (opens in a new tab)</span>}
                          </a>
                        ))}
                      </div>
                    )}
                  </>
                ))}
              </section>
            ))}
          </div>
        </div>
      </div>
    </dialog>
  ))}
</BaseLayout>

<script>
  import gsap from 'gsap';

  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-track]')!;
      const dotsBox = root.querySelector<HTMLElement>('[data-dots]')!;
      const total = track.children.length;
      const interval = Number(root.dataset.interval) || 4000;
      const delay = Number(root.dataset.delay) || 0;
      let index = 0;
      let timer: number | null = null;
      let starter: number | null = null;

      const dots: HTMLButtonElement[] = [];
      for (let i = 0; i < total; i++) {
        const d = document.createElement('button');
        d.type = 'button';
        d.className = 'kc__dot' + (i === 0 ? ' active' : '');
        d.setAttribute('aria-label', `Show slide ${i + 1}`);
        d.addEventListener('click', () => go(i));
        dotsBox.appendChild(d);
        dots.push(d);
      }

      function go(i: number) {
        index = i;
        track.style.transform = `translateX(-${i * 100}%)`;
        dots.forEach((d, k) => d.classList.toggle('active', k === i));
      }
      function start() {
        if (timer || total < 2) return;
        timer = window.setInterval(() => go((index + 1) % total), interval);
      }
      function stop() {
        if (starter) { clearTimeout(starter); starter = null; }
        if (timer) { clearInterval(timer); timer = null; }
      }
      function startLater() { stop(); starter = window.setTimeout(start, delay); }

      new IntersectionObserver((entries) => entries.forEach((e) => (e.isIntersecting ? startLater() : stop())), { rootMargin: '50px' }).observe(root);
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : startLater()));
    });
  }

  function initModals() {
    document.querySelectorAll<HTMLElement>('[data-modal-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        (document.getElementById(`modal-${btn.dataset.modalOpen}`) as HTMLDialogElement | null)?.showModal();
      });
    });
    document.querySelectorAll<HTMLDialogElement>('dialog.kc__dialog').forEach((dlg) => {
      dlg.querySelector('[data-modal-close]')?.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    });
  }

  function initCountdown() {
    const root = document.querySelector<HTMLElement>('[data-countdown]');
    if (!root) return;
    const start = new Date(root.dataset.start || '').getTime();
    const end = new Date(root.dataset.end || '').getTime();
    if (Number.isNaN(start)) return;
    const label = root.querySelector<HTMLElement>('[data-cd-label]')!;
    const grid = root.querySelector<HTMLElement>('[data-cd-grid]')!;
    const note = root.querySelector<HTMLElement>('[data-cd-note]')!;
    const num = (k: string) => root.querySelector<HTMLElement>(`[data-cd="${k}"]`)!;
    const pad = (n: number) => String(n).padStart(2, '0');
    let id = 0;

    function tick() {
      const now = Date.now();
      const diff = start - now;
      if (diff > 0) {
        const s = Math.floor(diff / 1000);
        num('days').textContent = pad(Math.floor(s / 86400));
        num('hours').textContent = pad(Math.floor((s % 86400) / 3600));
        num('minutes').textContent = pad(Math.floor((s % 3600) / 60));
        num('seconds').textContent = pad(s % 60);
        return;
      }
      grid.hidden = true;
      note.hidden = true;
      if (!Number.isNaN(end) && now >= end) {
        label.textContent = 'Thanks for joining us at KAMECON 2026!';
        clearInterval(id);
      } else {
        label.textContent = 'KAMECON is happening now!';
      }
    }

    root.hidden = false;
    tick();
    id = window.setInterval(tick, 1000);
  }

  function init() {
    initCarousels();
    initModals();
    initCountdown();
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.from('[data-kc-in]', { y: 40, opacity: 0, duration: 0.7, stagger: 0.15, ease: 'power3.out' });
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>

<style>
  .kc {
    --kc-bg: #0b0d12;
    --kc-surface: #131b29;
    --kc-blue: #2f8fe0;
    --kc-border: #4a2433;
    --kc-hi: #ff8a9b;
    --kc-title-blue: #1e9bff;
    --kc-font-title: 'Orbitron', sans-serif;
    --kc-font-head: 'Oxanium', sans-serif;
    --kc-font-label: 'Share Tech Mono', monospace;
    --kc-text: #e6ecf3;
    --kc-sub: #8a97aa;
    --kc-red: #e0314f;
    --kc-rose: #b8527a;
    --kc-ph: #1a2030;
    position: relative;
    min-height: 100vh;
    background: var(--kc-bg);
    color: var(--kc-text);
    font-family: 'Chakra Petch', sans-serif;
    padding: 0 clamp(1rem, 4vw, 3rem) 2.5rem;
  }

  .kc__bg { position: fixed; inset: 0; z-index: 0; background-size: cover; background-position: center; pointer-events: none; }
  .kc__bg::after { content: ''; position: absolute; inset: 0; background: rgba(11, 13, 18, 0.85); }
  .kc > :not(.kc__bg) { position: relative; z-index: 1; }

  .kc__top { padding-top: 1.5rem; }
  .kc__tas {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.3rem;

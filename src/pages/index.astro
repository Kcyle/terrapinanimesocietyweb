---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../sections/HeroSection.astro';
import HeroContent from '../components/HeroContent.astro';
import AboutSection from '../components/AboutSection.astro';
import NowScreening from '../components/NowScreening.astro';
import ActivitiesSection from '../components/ActivitiesSection.astro';
import SubgroupsSection from '../components/SubgroupsSection.astro';
import PartnersSection from '../components/PartnersSection.astro';
---

<BaseLayout title={site.pageTitles.home}>
  <Header />

  <main>
    <HeroSection>
      <HeroContent />
    </HeroSection>

    <AboutSection />
    <NowScreening />
    <SubgroupsSection />
    <PartnersSection />
    <ActivitiesSection />
    
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../animations/index';
</script>

<div class="coming-soon" data-coming-soon-modal aria-hidden="true">
  <div class="coming-soon__backdrop" data-coming-soon-backdrop></div>

  <div class="coming-soon__card" role="dialog" aria-modal="true" aria-labelledby="coming-soon-title">
    <button class="coming-soon__close" type="button" aria-label="Close" data-coming-soon-close>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <span class="coming-soon__bg-text" aria-hidden="true">KAMECON</span>
    <h3 class="coming-soon__title" id="coming-soon-title">Coming Soon</h3>
    <p class="coming-soon__desc">Plans for KAMECON 2026 are underway. This page will go live once details are locked in.</p>

    <button class="coming-soon__button" type="button" data-coming-soon-close>Got it</button>
  </div>
</div>

<style>
  .coming-soon {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--page-padding);
    visibility: hidden;
    pointer-events: none;
  }

  .coming-soon[data-open="true"] {
    visibility: visible;
    pointer-events: auto;
  }

  .coming-soon__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.75);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .coming-soon[data-open="true"] .coming-soon__backdrop {
    opacity: 1;
  }

  .coming-soon__card {
    position: relative;
    width: min(420px, 100%);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--accent);
    border-radius: 14px;
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
    overflow: hidden;
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .coming-soon[data-open="true"] .coming-soon__card {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .coming-soon__close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-fast);
  }

  .coming-soon__close:hover {
    border-color: var(--color-border-hover);
  }

  .coming-soon__bg-text {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: clamp(2.25rem, 12vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.35);
    margin-bottom: -0.6rem;
    user-select: none;
  }

  .coming-soon__title {
    font-family: 'Inter', sans-serif;
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-sm);
  }

  .coming-soon__desc {
    font-size: var(--font-size-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 320px;
    margin: 0 auto var(--space-xl);
  }

  .coming-soon__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.75rem;
    font-family: 'Inter', sans-serif;
    font-size: var(--font-size-sm);
    font-weight: 600;
    border-radius: 8px;
    background-color: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--accent);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .coming-soon__button:hover {
    background-color: var(--accent-dark);
    border-color: var(--accent-dark);
  }

  @media (max-width: 640px) {
    .coming-soon__card {
      padding: var(--space-xl) var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coming-soon__backdrop,
    .coming-soon__card {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    const modal = document.querySelector('[data-coming-soon-modal]') as HTMLElement;
    if (!modal) return;

    const backdrop = modal.querySelector('[data-coming-soon-backdrop]');
    const closeButtons = modal.querySelectorAll('[data-coming-soon-close]');
    const focusableEls = Array.from(
      modal.querySelectorAll('button')
    ) as HTMLElement[];
    const firstFocusable = focusableEls[0];
    const lastFocusable = focusableEls[focusableEls.length - 1];
    let lastFocused: HTMLElement | null = null;

    function setInertOnBackground(makeInert: boolean) {
      Array.from(document.body.children).forEach((child) => {
        if (child === modal) return;
        if (makeInert) {
          child.setAttribute('inert', '');
          child.setAttribute('aria-hidden', 'true');
        } else {
          child.removeAttribute('inert');
          child.removeAttribute('aria-hidden');
        }
      });
    }

    function openModal() {
      lastFocused = document.activeElement as HTMLElement;
      modal.setAttribute('data-open', 'true');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setInertOnBackground(true);
      firstFocusable?.focus();

      const navMenu = document.querySelector('[data-menu]');
      if (navMenu) {
        navMenu.setAttribute('data-open', 'false');
      }
    }

    function closeModal() {
      modal.setAttribute('data-open', 'false');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setInertOnBackground(false);
      lastFocused?.focus();
    }

    function trapFocus(e: KeyboardEvent) {
      if (e.key !== 'Tab' || modal.getAttribute('data-open') !== 'true') return;
      if (!firstFocusable || !lastFocusable) return;

      if (e.shiftKey && document.activeElement === firstFocusable) {
        e.preventDefault();
        lastFocusable.focus();
      } else if (!e.shiftKey && document.activeElement === lastFocusable) {
        e.preventDefault();
        firstFocusable.focus();
      }
    }

    backdrop?.addEventListener('click', closeModal);
    closeButtons.forEach((button) => button.addEventListener('click', closeModal));

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.getAttribute('data-open') === 'true') {
        closeModal();
      }
      trapFocus(e);
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const link = target.closest('a[href="/kamecon"]');
      if (!link) return;

      e.preventDefault();
      openModal();
    });
  })();
</script>

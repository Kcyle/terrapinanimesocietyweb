---
import activities from '../data/activities.json';
---

<section class="section activities" id="activities-section">
  <div class="section__inner">
    <p class="section__eyebrow">06 /Activities</p>
    <h2 class="section__title">Past {activities.title}</h2>
    <p class="section__subtitle">{activities.description}</p>

    <div class="activities__grid">
      {activities.cards.map((card) => (
        <div class="activities__card">
          <h3 class="activities__card-name">{card.name}</h3>
          {card.feature && <span class="activities__card-feat">{card.feature}</span>}
          <p class="activities__card-desc">{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .activities {
    background-color: var(--panel-bg-alt);
  }

  .activities__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .activities__card {
    background: #ffffff;
    color: #0a0a0a;
    border: 2px solid #000;
    border-radius: 4px;
    padding: 1.5rem;
    box-shadow: 6px 6px 0 #000;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .activities__card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 #000;
  }

  .activities__card-name {
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #000;
  }

  .activities__card-feat {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: #000;
    padding: 0.25rem 0.5rem;
    margin: 0.5rem 0 0;
  }

  .activities__card-desc {
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.55;
    margin: 0.6rem 0 0;
  }
</style>

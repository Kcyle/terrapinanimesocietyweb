---
import screeningsData from '../data/screenings.json';
import { generateScreeningDates, formatScreeningDate } from '../utils/anime';

const { screenings, startDate, location } = screeningsData;
const dates = generateScreeningDates(startDate, screenings.length);

const schedule = screenings.map((screening, index) => ({
  ...screening,
  date: dates[index],
  formattedDate: formatScreeningDate(dates[index]),
}));
---

<section class="section meetings" id="meetings-section">
  <div class="section__inner">
    <p class="section__eyebrow">03 / Meetings</p>
    <h2 class="section__title">{screeningsData.meetingsHeading}</h2>

    <div class="meetings__screenings">
      <h3 class="meetings__screenings-title">{screeningsData.screeningsTitle}</h3>
      <p class="meetings__screenings-subtitle">{screeningsData.screeningsSubtitle}</p>

      <div class="meetings__viewer" data-anime-viewer>
        {schedule.length > 1 && (
          <button class="meetings__arrow meetings__arrow--left" data-arrow-left aria-label="Previous anime">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        )}

        <div class="meetings__anime-display">
          {schedule.map((anime, index) => (
            <div
              class={`meetings__anime-slide ${index === 0 ? 'meetings__anime-slide--active' : ''}`}
              data-slide={index}
            >
              <div class="meetings__anime-poster">
                {anime.image ? (
                  <img src={anime.image} alt={anime.title} loading="lazy" />
                ) : (
                  <div class="meetings__anime-poster-placeholder" aria-hidden="true">{anime.title}</div>
                )}
              </div>
              <div class="meetings__anime-details">
                {anime.scheduled !== false && (
                  <span class="meetings__anime-date">{anime.formattedDate}</span>
                )}
                <h4 class="meetings__anime-title">{anime.title}</h4>
                {anime.score && (
                  <span class="meetings__anime-score">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    {anime.score}
                  </span>
                )}
                {anime.episodes && (
                  <div class="meetings__anime-meta">
                    <span class="meetings__anime-episodes">{anime.episodes} Episodes</span>
                  </div>
                )}
                <p class="meetings__anime-synopsis">
                  {anime.synopsis.length > 280
                    ? anime.synopsis.substring(0, 280) + '...'
                    : anime.synopsis}
                </p>
              </div>
            </div>
          ))}
        </div>

        {schedule.length > 1 && (
          <button class="meetings__arrow meetings__arrow--right" data-arrow-right aria-label="Next anime">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        )}
      </div>

      {schedule.length > 1 && (
        <div class="meetings__thumbnails" data-thumbnails>
          {schedule.map((anime, index) => (
            <button
              class={`meetings__thumbnail ${index === 0 ? 'meetings__thumbnail--active' : ''}`}
              data-thumbnail={index}
              aria-label={`Go to ${anime.title}`}
            >
              <img src={anime.image} alt={anime.title} loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="meetings__location">
      <div class="meetings__location-image">
        <img src="/images/Photos/sociology.webp" alt="Parren J Mitchell Art-Sociology Building" />
      </div>
      <div class="meetings__location-info">
        <h3 class="meetings__location-name">{location.building}</h3>
        <p class="meetings__location-address">{location.address}</p>
        <div class="meetings__location-rooms">
          {location.rooms.map((room) => (
            <div class="meetings__location-room">
              <span class="meetings__location-room-label">{room.label}</span>
              <span class="meetings__location-room-value">{room.value}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .meetings {
    background-color: var(--panel-bg);
    padding-top: calc(var(--space-4xl) + 4rem);
  }

  @media (max-width: 768px) {
    .meetings {
      padding-top: calc(var(--space-4xl) + 3rem);
    }
  }

  .meetings__screenings {
    max-width: 900px;
    margin: 0 auto 3rem;
  }

  .meetings__screenings-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-align: center;
    margin: 0 0 0.35rem;
  }

  .meetings__screenings-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    text-align: center;
    margin: 0 0 2rem;
  }

  .meetings__viewer {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .meetings__arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-bg-tertiary);
    border: 2px solid var(--color-border);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease;
  }

  .meetings__arrow:hover {
    border-color: var(--color-border-hover);
  }

  .meetings__anime-display {
    flex: 1;
    position: relative;
    min-height: 260px;
  }

  .meetings__anime-slide {
    position: absolute;
    inset: 0;
    display: flex;
    gap: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .meetings__anime-slide--active {
    opacity: 1;
    pointer-events: auto;
    position: relative;
  }

  .meetings__anime-poster {
    flex-shrink: 0;
    width: 150px;
    aspect-ratio: 2 / 3;
    border-radius: 8px;
    overflow: hidden;
  }

  .meetings__anime-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meetings__anime-poster-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-tertiary);
    border: 2px solid var(--accent);
    border-radius: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  .meetings__anime-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .meetings__anime-date {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .meetings__anime-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.4rem;
  }

  .meetings__anime-score {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-gold);
    margin-bottom: 0.4rem;
  }

  .meetings__anime-episodes {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    background: var(--color-bg-tertiary);
    border-radius: 4px;
  }

  .meetings__anime-synopsis {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0.6rem 0 0;
    max-width: 55ch;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .meetings__thumbnails {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .meetings__thumbnail {
    width: 44px;
    aspect-ratio: 2 / 3;
    border-radius: 4px;
    overflow: hidden;
    border: 2px solid transparent;
    background: var(--color-bg-tertiary);
    cursor: pointer;
    padding: 0;
    opacity: 0.5;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .meetings__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meetings__thumbnail:hover {
    opacity: 0.8;
  }

  .meetings__thumbnail--active {
    opacity: 1;
    border-color: #ffffff;
  }

  .meetings__location {
    display: flex;
    align-items: stretch;
    max-width: 800px;
    margin: 0 auto;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .meetings__location-image {
    flex-shrink: 0;
    width: 220px;
  }

  .meetings__location-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .meetings__location-info {
    flex: 1;
    padding: 1.5rem;
    min-width: 0;
  }

  .meetings__location-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.35rem;
  }

  .meetings__location-address {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0 0 1rem;
  }

  .meetings__location-rooms {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .meetings__location-room {
    flex: 1;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.6rem 0.8rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }

  .meetings__location-room-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .meetings__location-room-value {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  @media (max-width: 720px) {
    .meetings__anime-slide {
      flex-direction: column;
    }

    .meetings__anime-synopsis {
      max-width: 100%;
    }

    .meetings__location {
      flex-direction: column;
    }

    .meetings__location-image {
      width: 100%;
      height: 180px;
    }
  }
</style>

<script>
  (function() {
    const slides = document.querySelectorAll('.meetings__anime-slide') as NodeListOf<HTMLElement>;
    const thumbnails = document.querySelectorAll('.meetings__thumbnail') as NodeListOf<HTMLElement>;
    const leftArrow = document.querySelector('[data-arrow-left]') as HTMLElement;
    const rightArrow = document.querySelector('[data-arrow-right]') as HTMLElement;

    if (slides.length === 0) return;

    let currentIndex = 0;
    const totalSlides = slides.length;

    function goToSlide(index: number) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;

      slides.forEach((slide, i) => {
        slide.classList.toggle('meetings__anime-slide--active', i === index);
      });

      thumbnails.forEach((thumb, i) => {
        thumb.classList.toggle('meetings__thumbnail--active', i === index);
      });

      currentIndex = index;
    }

    leftArrow?.addEventListener('click', () => goToSlide(currentIndex - 1));
    rightArrow?.addEventListener('click', () => goToSlide(currentIndex + 1));

    thumbnails.forEach((thumb, i) => {
      thumb.addEventListener('click', () => goToSlide(i));
    });
  })();
</script>

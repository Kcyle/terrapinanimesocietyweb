---
import partners from '../data/partners.json';

const { logos, showcase } = partners;
---

<section class="section partners" id="partners-section">
  <div class="section__inner">
    <p class="section__eyebrow">05 / Partners</p>
    <h2 class="section__title">{partners.title}</h2>

    <div class="partners__logos">
      {logos.map((logo) => (
        <a href={logo.url} target="_blank" rel="noopener" class={`partners__logo partners__logo--${logo.position}`}>
          <img src={logo.image} alt={logo.name} />
        </a>
      ))}
    </div>

    <p class="partners__blurb">
      {showcase.headlineBefore} <strong>{showcase.headlinePartner}</strong>{showcase.headlineMiddle} <strong>{showcase.headlineHighlight}</strong> {showcase.headlineAfter}
    </p>

    <div class="partners__posters">
      {showcase.posters.map((poster) => (
        <div class={poster.featured ? 'poster poster--featured' : 'poster'}>
          <div class="poster__frame">
            <img src={poster.image} alt={poster.title} />
          </div>
          <span class="poster__title">{poster.title}</span>
          <span class={poster.upcoming ? 'poster__status poster__status--upcoming' : 'poster__status'}>{poster.status}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners {
    background-color: var(--panel-bg-alt);
  }

  .partners__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    padding: 2rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .partners__logo img {
    height: 60px;
    width: auto;
    object-fit: contain;
    opacity: 0.9;
    transition: opacity 0.15s ease;
  }

  .partners__logo:hover img {
    opacity: 1;
  }

  .partners__logo--center img {
    filter: brightness(0) invert(1);
  }

  .partners__blurb {
    max-width: 640px;
    margin: 0 auto 2.5rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .partners__blurb strong {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .partners__posters {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .poster {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 130px;
  }

  .poster--featured {
    width: 160px;
  }

  .poster__frame {
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .poster__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster__title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-align: center;
  }

  .poster__status {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .poster__status--upcoming {
    color: var(--accent);
  }
</style>

---
import subgroups from '../data/subgroups.json';

const { list } = subgroups;
---

<section class="section subgroups" id="subgroups-section">
  <div class="subgroups__bg" aria-hidden="true">
    <div
      class="subgroups__bg-layer subgroups__bg-layer--a subgroups__bg-layer--visible"
      style={`background-image: url("${list[0].previewImage}"); background-size: ${list[0].previewImageFit || 'cover'};`}
      data-subgroups-bg-a
    ></div>
    <div class="subgroups__bg-layer subgroups__bg-layer--b" data-subgroups-bg-b></div>
    <div class="subgroups__bg-scrim"></div>
  </div>

  <div class="section__inner">
    <p class="section__eyebrow">04 / Subgroups</p>
    <h2 class="section__title">{subgroups.heading}<span> — {subgroups.subtitle}</span></h2>
  </div>

  <div class="subgroups__stage">
    <div class="subgroups__flanks" aria-hidden="true">
      {list.flatMap((subgroup, index) =>
        subgroup.photos.map((photo) => (
          <div
            class={`subgroups__flank subgroups__flank--${photo.side} ${index === 0 ? 'subgroups__flank--active' : ''}`}
            data-subgroup-flank
            data-subgroup-index={index}
          >
            <img src={photo.src} alt={photo.alt} loading="lazy" class="subgroups__flank-image" />
          </div>
        ))
      )}
    </div>

    <div class="subgroups__panels" aria-hidden="false">
      {list.map((subgroup, index) => (
        <div
          class={`subgroups__intro ${index === 0 ? 'subgroups__intro--active' : ''}`}
          id={`subgroup-${subgroup.id}`}
          data-subgroup-slide
          data-subgroup-index={index}
          data-subgroup-bg={subgroup.previewImage}
          data-subgroup-bg-fit={subgroup.previewImageFit || 'cover'}
        >
          <h3 class="subgroups__intro-name">{subgroup.name}</h3>
          <p class="subgroups__intro-tagline">{subgroup.tagline}</p>
        </div>
      ))}

      {list.map((subgroup, index) => (
        <div
          class={`subgroups__info ${index === 0 ? 'subgroups__info--active' : ''}`}
          data-subgroup-info
          data-subgroup-index={index}
        >
          {subgroup.meets && (
            <p class="subgroups__info-row"><span>Meets</span>{subgroup.meets}</p>
          )}
          <p class="subgroups__info-row"><span>Leader</span>{subgroup.leader}</p>
          <p class="subgroups__info-desc">{subgroup.description}</p>
        </div>
      ))}
    </div>

    {list.length > 1 && (
      <div class="subgroups__carousel" data-subgroups-carousel>
        <button class="subgroups__arrow subgroups__arrow--left" data-subgroups-arrow-left aria-label="Previous subgroup">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="subgroups__arrow subgroups__arrow--right" data-subgroups-arrow-right aria-label="Next subgroup">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    )}
  </div>
</section>

<style>
  .subgroups {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--panel-bg);
    overflow: hidden;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .subgroups .section__inner {
    position: relative;
    z-index: 3;
    width: 100%;
    flex: none;
    margin-bottom: 2rem;
  }

  .subgroups .section__title {
    margin-bottom: 0;
  }

  .subgroups__stage {
    position: relative;
    flex: 1;
    min-height: 320px;
  }

  .subgroups__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .subgroups__bg-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .subgroups__bg-layer--visible {
    opacity: 1;
  }

  .subgroups__bg-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.15) 25%, rgba(0, 0, 0, 0.15) 70%, rgba(0, 0, 0, 0.45) 100%);
  }

  .subgroups__flanks {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .subgroups__flank {
    position: absolute;
    max-width: 30vw;
    display: flex;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .subgroups__flank--active {
    opacity: 1;
  }

  .subgroups__flank--left {
    left: 0;
    bottom: 0;
    align-items: flex-end;
    justify-content: flex-start;
  }

  .subgroups__flank--right {
    right: 0;
    top: 0;
    align-items: flex-start;
    justify-content: flex-end;
  }

  .subgroups__flank-image {
    height: 40vh;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @media (max-width: 992px) {
    .subgroups__flank {
      display: none;
    }
  }

  .subgroups__panels {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .subgroups__intro,
  .subgroups__info {
    position: absolute;
    max-width: min(28rem, 80vw);
    background: rgba(26, 26, 26, 0.68);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .subgroups__intro--active,
  .subgroups__info--active {
    opacity: 1;
  }

  .subgroups__intro {
    top: 0;
    left: var(--page-padding);
  }

  .subgroups__info {
    bottom: 2.5rem;
    right: var(--page-padding);
    text-align: right;
  }

  .subgroups__intro-name {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 0.35rem;
    color: var(--color-text-primary);
  }

  .subgroups__intro-tagline {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }

  .subgroups__info-row {
    font-size: 0.85rem;
    color: var(--color-text-primary);
    font-weight: 700;
    margin: 0 0 0.35rem;
  }

  .subgroups__info-row span {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.15rem;
  }

  .subgroups__info-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0.75rem 0 0;
  }

  .subgroups__carousel {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--page-padding);
    pointer-events: none;
  }

  .subgroups__arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-bg-tertiary);
    border: 2px solid var(--color-border);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s ease;
    pointer-events: auto;
  }

  .subgroups__arrow:hover {
    border-color: var(--color-border-hover);
  }

  @media (max-width: 640px) {
    .subgroups__panels {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 0 var(--page-padding) 1.5rem;
    }

    .subgroups__intro,
    .subgroups__info {
      position: static;
      display: none;
      opacity: 1;
      max-width: none;
      width: 100%;
      text-align: left;
    }

    .subgroups__intro--active,
    .subgroups__info--active {
      display: block;
    }
  }
</style>

<script>
  (function() {
    const section = document.getElementById('subgroups-section') as HTMLElement;
    const slides = document.querySelectorAll('[data-subgroup-slide]') as NodeListOf<HTMLElement>;
    const infoPanels = document.querySelectorAll('[data-subgroup-info]') as NodeListOf<HTMLElement>;
    const flanks = document.querySelectorAll('[data-subgroup-flank]') as NodeListOf<HTMLElement>;
    const leftArrow = document.querySelector('[data-subgroups-arrow-left]') as HTMLElement;
    const rightArrow = document.querySelector('[data-subgroups-arrow-right]') as HTMLElement;
    const bgLayerA = document.querySelector('[data-subgroups-bg-a]') as HTMLElement;
    const bgLayerB = document.querySelector('[data-subgroups-bg-b]') as HTMLElement;

    if (slides.length === 0) return;

    const totalSlides = slides.length;
    let currentIndex = 0;
    let showingLayerA = true;

    function setBackground(index: number) {
      if (!bgLayerA || !bgLayerB) return;
      const src = slides[index].dataset.subgroupBg;
      if (!src) return;
      const fit = slides[index].dataset.subgroupBgFit || 'cover';

      const incoming = showingLayerA ? bgLayerB : bgLayerA;
      const outgoing = showingLayerA ? bgLayerA : bgLayerB;

      incoming.style.backgroundImage = `url("${src}")`;
      incoming.style.backgroundSize = fit;
      incoming.classList.add('subgroups__bg-layer--visible');
      outgoing.classList.remove('subgroups__bg-layer--visible');

      showingLayerA = !showingLayerA;
    }

    function goToSlide(index: number, updateHash = true) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;

      slides.forEach((slide, i) => {
        slide.classList.toggle('subgroups__intro--active', i === index);
      });

      infoPanels.forEach((panel) => {
        const panelIndex = Number(panel.dataset.subgroupIndex);
        panel.classList.toggle('subgroups__info--active', panelIndex === index);
      });

      flanks.forEach((flank) => {
        const flankIndex = Number(flank.dataset.subgroupIndex);
        flank.classList.toggle('subgroups__flank--active', flankIndex === index);
      });

      setBackground(index);
      currentIndex = index;

      if (updateHash) {
        const id = slides[index].id;
        if (id && history.replaceState) {
          history.replaceState(null, '', `#${id}`);
        }
      }
    }

    leftArrow?.addEventListener('click', () => goToSlide(currentIndex - 1));
    rightArrow?.addEventListener('click', () => goToSlide(currentIndex + 1));

    // Arrow-key navigation, only while the section is actually in view.
    let isInView = false;
    if (section && totalSlides > 1) {
      const visibilityObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isInView = entry.isIntersecting;
          });
        },
        { threshold: 0.4 }
      );
      visibilityObserver.observe(section);

      window.addEventListener('keydown', (e) => {
        if (!isInView) return;

        const target = e.target as HTMLElement;
        if (target && ['INPUT', 'TEXTAREA'].includes(target.tagName)) return;

        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goToSlide(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          goToSlide(currentIndex + 1);
        }
      });
    }

    function syncToHash() {
      const hash = window.location.hash.replace('#', '');
      if (!hash) return;

      const index = Array.from(slides).findIndex((slide) => slide.id === hash);
      if (index !== -1 && index !== currentIndex) {
        goToSlide(index, false);
        slides[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    window.addEventListener('hashchange', syncToHash);
    syncToHash();
  })();
</script>

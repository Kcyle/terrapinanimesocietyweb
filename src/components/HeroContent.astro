---
import CardCarousel from './CardCarousel.astro';
import home from '../data/home.json';

const { hero } = home;
---

<div class="hero-content">
  <div class="hero-content__title-wrapper">
    <span class="hero-content__background-text" aria-hidden="true">TAS</span>
    <h1 class="hero-content__title">
      {hero.titleLines.map((line) => (
        <span class="hero-content__title-line">{line}</span>
      ))}
    </h1>
  </div>
  <p class="hero-content__description">{hero.description}</p>
  <div class="hero-content__buttons">
    {hero.buttons.map((button) => (
      <a href={button.url} class={`hero-content__button hero-content__button--${button.variant}`}>{button.label}</a>
    ))}
  </div>

  <div class="hero-carousel-wrapper">
    <CardCarousel />
  </div>
</div>

<style>
  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-content__title-wrapper {
    position: relative;
    min-height: 7.5vw;
  }

  .hero-content__background-text {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    font-family: 'Inter', sans-serif;
    font-size: 15.83vw;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.35);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .hero-content__title {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero-content__title-line {
    font-family: 'Inter', sans-serif;
    font-size: 4.17vw;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #ffffff;
    text-transform: uppercase;
    display: block;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.9), 0 2px 10px rgba(0, 0, 0, 0.7);
  }

  .hero-content__description {
    position: relative;
    z-index: 1;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    color: #a0a0a0;
    max-width: 640px;
    margin-top: 0.5rem;
  }

  .hero-content__buttons {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .hero-content__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .hero-content__button--primary {
    background-color: var(--accent);
    color: #ffffff;
    border: 1px solid var(--accent);
  }

  .hero-content__button--primary:hover {
    background-color: var(--accent-dark);
  }

  .hero-content__button--secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .hero-content__button--secondary:hover {
    border-color: rgba(255, 255, 255, 0.6);
  }

  .hero-carousel-wrapper {
    position: relative;
    z-index: 10;
    margin-top: 1rem;
    width: min(100%, 720px);
    height: 220px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

  @media (max-width: 768px) {
    .hero-content__title-wrapper {
      min-height: 80px;
    }

    .hero-content__background-text {
      font-size: 120px;
    }

    .hero-content__title-line {
      font-size: 40px;
    }

    .hero-content__description {
      font-size: 14px;
      max-width: 100%;
    }

    .hero-content__buttons {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .hero-content__button {
      padding: 12px 24px;
      font-size: 14px;
      width: 100%;
      max-width: 280px;
    }

    .hero-carousel-wrapper {
      height: 35dvh;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
